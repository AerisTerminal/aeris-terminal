# Risikoregeln: der Bereich im Kontenfenster, der das Risikoprofil eines Übungskontos bearbeitet
# (Tageslimits, das tägliche Gewinnziel und den maximalen Drawdown) und die Live-Anzeige zeigt.

tab = Risikoregeln
heading = Risikoregeln
intro = Regeln, die Aeris auf einem Übungskonto durchsetzt, wie bei einer Prop-Firm-Evaluierung. Wird eine Regel erreicht, wird das Konto gesperrt und neue Orders werden abgelehnt. Tagesregeln werden an der Sitzungsgrenze zurückgesetzt, der maximale Drawdown nicht. Brokerkonten unterliegen den Regeln ihres Brokers.
no_practice_accounts = Legen Sie unter Handelskonten ein Übungskonto an, um ihm Risikoregeln zu geben.
account_label = Übungskonto
account_description = Das Übungskonto, für das diese Regeln gelten.
choose_account = Übungskonto wählen
enabled_label = Regeln durchsetzen
status_not_saved = Für dieses Konto sind noch keine Regeln gespeichert.
status_enabled = Die gespeicherten Regeln werden durchgesetzt.
status_disabled = Die gespeicherten Regeln sind ausgeschaltet und werden nicht durchgesetzt.
daily_heading = Tagesregeln
daily_loss_label = Tagesverlustlimit
daily_loss_description = Das Konto wird gesperrt, wenn der Verlust der Sitzung diesen Betrag erreicht.
maximum_contracts_label = Maximale Kontrakte
maximum_contracts_description = Orders, durch die mehr Kontrakte gehalten würden, werden abgelehnt.
trailing_label = Nachlaufender Drawdown
trailing_description = Das Konto wird gesperrt, wenn das Sitzungs-G&V so weit unter sein Sitzungshoch fällt.
trailing_mode_label = Modus des nachlaufenden Drawdowns
trailing_mode_description = Intraday folgt jedem neuen Hoch; Tagesende verschiebt das Hoch nur an der Sitzungsgrenze.
consistency_label = Konsistenzlimit (%)
consistency_description = Warnt, wenn ein einzelner Gewinntrade mehr als diesen Prozentsatz des Sitzungsgewinns ausmacht.
profit_target_label = Tägliches Gewinnziel
profit_target_description = Das Konto wird für den Rest der Sitzung gesperrt, sobald das Sitzungs-G&V diesen Betrag erreicht.
drawdown_heading = Maximaler Drawdown
drawdown_intro = Der maximale Drawdown folgt dem höchsten Kapital des Kontos über alle Sitzungen. Ist er erreicht, bleibt das Konto gesperrt, bis Sie es unter Live-Anzeige entsperren; die Sitzungsgrenze hebt die Sperre nicht auf.
maximum_drawdown_label = Maximaler Drawdown
maximum_drawdown_description = Das Konto wird gesperrt, wenn das Kapital so weit unter sein höchstes Kapital fällt.
drawdown_mode_label = Drawdown-Modus
drawdown_mode_description = Intraday hebt das Hoch aus dem Live-Kapital an; Tagesende hebt es nur aus dem Kapital an der Sitzungsgrenze an.
floor_stop_label = Untergrenze endet bei
floor_stop_description = Das Kapital, bei dem die Sperrgrenze nicht weiter steigt, meist der Startsaldo. Leer lassen, um ohne Grenze nachzulaufen.
mode_intraday = Intraday
mode_end_of_day = Tagesende
placeholder_amount = Betrag
placeholder_contracts = Kontrakte
placeholder_off = Aus
unsaved_changes = Nicht gespeicherte Änderungen
save = Regeln speichern
saved = Risikoregeln gespeichert.
meter_heading = Live-Anzeige
meter_empty = Die Anzeige erscheint, sobald für dieses Konto Regeln gespeichert sind.
meter_session_pnl = Sitzungs-G&V
meter_daily_loss_remaining = Abstand zum Tagesverlustlimit
meter_trailing_remaining = Abstand zum nachlaufenden Drawdown
meter_profit_target_remaining = Verbleibend bis zum Gewinnziel
meter_drawdown_peak = Höchstes Kapital
meter_drawdown_floor = Sperrgrenze des Drawdowns
meter_drawdown_remaining = Abstand zum maximalen Drawdown
meter_lock = Sperre
meter_unlocked = Nicht gesperrt
unlock = Konto entsperren
problem_no_account = Wählen Sie ein Übungskonto.
problem_daily_loss = Geben Sie ein Tagesverlustlimit über null in der Kontowährung ein.
problem_maximum_contracts = Geben Sie eine maximale Anzahl Kontrakte über null ein.
problem_trailing = Geben Sie einen nachlaufenden Drawdown über null in der Kontowährung ein oder lassen Sie das Feld leer.
problem_consistency = Geben Sie ein Konsistenzlimit von 1 bis 100 ein oder lassen Sie das Feld leer.
problem_profit_target = Geben Sie ein tägliches Gewinnziel über null in der Kontowährung ein oder lassen Sie das Feld leer.
problem_maximum_drawdown = Geben Sie einen maximalen Drawdown über null in der Kontowährung ein oder lassen Sie das Feld leer.
problem_floor_stop = Geben Sie das Kapital, bei dem die Untergrenze endet, über null in der Kontowährung ein oder lassen Sie das Feld leer.
problem_floor_stop_without_drawdown = Legen Sie einen maximalen Drawdown fest, bevor Sie wählen, wo seine Untergrenze endet.
problem_revision_exhausted = Diese Regeln haben ihre letzte Revision erreicht und können nicht mehr geändert werden.
save_failed = Die Risikoregeln konnten nicht gespeichert werden: {error}
