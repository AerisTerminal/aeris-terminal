# Regras de risco: a seção do painel de contas que edita o perfil de risco de uma conta simulada
# (limites diários, meta de lucro diária e drawdown máximo) e mostra o medidor ao vivo.

tab = Regras de risco
heading = Regras de risco
intro = Regras que o Aeris aplica a uma conta simulada, como em uma avaliação de mesa proprietária. Quando uma regra é atingida, a conta é bloqueada e novas ordens são recusadas. As regras diárias são reiniciadas no limite da sessão; o drawdown máximo não. Contas de corretora seguem as regras da corretora.
no_practice_accounts = Crie uma conta simulada em Contas de negociação para definir regras de risco.
account_label = Conta simulada
account_description = A conta simulada à qual estas regras se aplicam.
choose_account = Escolha uma conta simulada
enabled_label = Aplicar regras
status_not_saved = Ainda não há regras salvas para esta conta.
status_enabled = As regras salvas estão sendo aplicadas.
status_disabled = As regras salvas estão desativadas e não são aplicadas.
daily_heading = Regras diárias
daily_loss_label = Limite de perda diária
daily_loss_description = A conta é bloqueada quando a perda da sessão atinge este valor.
maximum_contracts_label = Máximo de contratos
maximum_contracts_description = Ordens que fariam a conta manter mais contratos que isso são recusadas.
trailing_label = Drawdown móvel
trailing_description = A conta é bloqueada quando o P&L da sessão cai este valor abaixo da máxima da sessão.
trailing_mode_label = Modo do drawdown móvel
trailing_mode_description = Intradiário acompanha cada nova máxima; fim do dia move a máxima apenas no limite da sessão.
consistency_label = Limite de consistência (%)
consistency_description = Avisa quando uma única operação vencedora representa mais que este percentual do lucro da sessão.
profit_target_label = Meta de lucro diária
profit_target_description = A conta é bloqueada pelo resto da sessão assim que o P&L da sessão atinge este valor.
drawdown_heading = Drawdown máximo
drawdown_intro = O drawdown máximo acompanha o maior patrimônio da conta entre sessões. Depois de atingido, a conta continua bloqueada até você desbloqueá-la em Medidor ao vivo; o limite da sessão não a libera.
maximum_drawdown_label = Drawdown máximo
maximum_drawdown_description = A conta é bloqueada quando o patrimônio cai este valor abaixo do maior patrimônio.
drawdown_mode_label = Modo do drawdown
drawdown_mode_description = Intradiário eleva a máxima a partir do patrimônio ao vivo; fim do dia a eleva apenas a partir do patrimônio no limite da sessão.
floor_stop_label = O piso para em
floor_stop_description = O patrimônio em que o nível de bloqueio para de subir, geralmente o saldo inicial. Deixe vazio para acompanhar sem limite.
mode_intraday = Intradiário
mode_end_of_day = Fim do dia
placeholder_amount = Valor
placeholder_contracts = Contratos
placeholder_off = Desativado
unsaved_changes = Alterações não salvas
save = Salvar regras
saved = Regras de risco salvas.
meter_heading = Medidor ao vivo
meter_empty = O medidor aparece quando há regras salvas para esta conta.
meter_session_pnl = P&L da sessão
meter_daily_loss_remaining = Margem até o limite de perda diária
meter_trailing_remaining = Margem até o drawdown móvel
meter_profit_target_remaining = Falta para a meta de lucro
meter_drawdown_peak = Maior patrimônio
meter_drawdown_floor = Nível de bloqueio do drawdown
meter_drawdown_remaining = Margem até o drawdown máximo
meter_lock = Bloqueio
meter_unlocked = Não bloqueada
unlock = Desbloquear conta
problem_no_account = Escolha uma conta simulada.
problem_daily_loss = Informe um limite de perda diária acima de zero na moeda da conta.
problem_maximum_contracts = Informe um número máximo de contratos acima de zero.
problem_trailing = Informe um drawdown móvel acima de zero na moeda da conta ou deixe vazio.
problem_consistency = Informe um limite de consistência de 1 a 100 ou deixe vazio.
problem_profit_target = Informe uma meta de lucro diária acima de zero na moeda da conta ou deixe vazio.
problem_maximum_drawdown = Informe um drawdown máximo acima de zero na moeda da conta ou deixe vazio.
problem_floor_stop = Informe o patrimônio em que o piso para, acima de zero na moeda da conta, ou deixe vazio.
problem_floor_stop_without_drawdown = Defina um drawdown máximo antes de escolher onde o piso para.
problem_revision_exhausted = Estas regras chegaram à última revisão e não podem ser alteradas.
save_failed = Não foi possível salvar as regras de risco: {error}
