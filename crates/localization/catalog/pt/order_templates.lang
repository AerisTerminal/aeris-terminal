# Problemas
whole_number_required = Digite um número inteiro no campo destacado.
invalid_identity = Este modelo não pode ser salvo com sua identidade. Feche o editor e tente novamente.
invalid_revision = Este modelo não pode ser salvo em sua revisão. Feche o editor e tente novamente.
invalid_name = Digite um nome de no máximo {maximum} caracteres, sem espaços no início ou no fim.
invalid_quantity = A quantidade deve ser de 1 a {maximum}.
invalid_stop = O stop deve ser de 1 a {maximum} ticks.
invalid_target_count = Um modelo precisa de pelo menos um alvo e comporta no máximo {maximum}.
invalid_target_offset = Cada alvo deve ser de 1 a {maximum} ticks.
invalid_target_order = Cada alvo deve estar mais longe da entrada do que o anterior.
invalid_target_quantity = Cada alvo deve ter uma quantidade de pelo menos 1.
invalid_target_total = As quantidades dos alvos devem somar a quantidade do modelo.
invalid_target_split = Essas quantidades de alvos não podem ser divididas com exatidão. Altere as quantidades dos alvos mais próximos.
invalid_trailing = A ativação e a distância do stop móvel devem ser de 1 a {maximum} ticks cada.
too_many = No máximo {maximum} modelos de ordem podem ser salvos. Exclua um primeiro.
unknown_template = Este modelo não está mais salvo.
revision_must_advance = Este modelo foi alterado em outro lugar. Feche o editor e abra-o novamente.
save_failed = Não foi possível salvar o modelo: {error}
delete_failed = Não foi possível excluir o modelo: {error}

