targets_full = Um copiador tem no máximo {maximum} destinos.
unsaved_changes = Alterações não salvas
save = Salvar copiador
recent_heading = Cópias recentes
recent_empty = Nenhuma ordem desta conta foi copiada desde que o Aeris iniciou.
dispatch_label = {side} {quantity} {symbol} → {account}
dispatch_label_no_quantity = {side} {symbol} → {account}
dispatch_copied_detail = A conta de destino aceitou a ordem copiada.
copied = Copiada
refused = Recusada
