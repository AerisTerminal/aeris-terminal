# Problems
whole_number_required = Enter a whole number in the highlighted field.
invalid_identity = This template cannot be saved under its identity. Close the editor and try again.
invalid_revision = This template cannot be saved at its revision. Close the editor and try again.
invalid_name = Enter a name of at most {maximum} characters, without leading or trailing spaces.
invalid_quantity = The quantity must be from 1 to {maximum}.
invalid_stop = The stop must be from 1 to {maximum} ticks.
invalid_target_count = A template needs at least one target and holds at most {maximum}.
invalid_target_offset = Each target must be from 1 to {maximum} ticks.
invalid_target_order = Each target must be further from the entry than the one before it.
invalid_target_quantity = Each target must take a quantity of at least 1.
invalid_target_total = The target quantities must add up to the template quantity.
invalid_target_split = These target quantities cannot be split exactly. Change the quantities of the nearer targets.
invalid_trailing = The trailing activation and distance must each be from 1 to {maximum} ticks.
too_many = At most {maximum} order templates can be saved. Delete one first.
unknown_template = This template is no longer saved.
revision_must_advance = This template was changed elsewhere. Close the editor and open it again.
save_failed = The template could not be saved: {error}
delete_failed = The template could not be deleted: {error}

