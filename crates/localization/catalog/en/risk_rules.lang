# Risk rules: the Accounts panel section that edits a practice account's risk profile (daily
# limits, the daily profit target and the maximum drawdown) and shows the owner's live meter.

tab = Risk rules
heading = Risk rules
intro = Rules Aeris enforces on a practice account, like a prop-firm evaluation. When a rule is reached the account locks and new orders are refused. Daily rules reset at the session boundary; the maximum drawdown does not. Broker accounts are governed by their broker.
no_practice_accounts = Create a practice account under Trading accounts to give it risk rules.
account_label = Practice account
account_description = The practice account these rules apply to.
choose_account = Choose a practice account
enabled_label = Enforce rules
status_not_saved = No rules are saved for this account yet.
status_enabled = The saved rules are enforced.
status_disabled = The saved rules are switched off and not enforced.
daily_heading = Daily rules
daily_loss_label = Daily loss limit
daily_loss_description = The account locks when the session's loss reaches this amount.
maximum_contracts_label = Maximum contracts
maximum_contracts_description = Orders that would hold more contracts than this are refused.
trailing_label = Trailing drawdown
trailing_description = The account locks when session P&L falls this far below its session high.
trailing_mode_label = Trailing drawdown mode
trailing_mode_description = Intraday follows every new high; end of day moves the high only at the session boundary.
consistency_label = Consistency limit (%)
consistency_description = Warns when one winning trade makes up more than this percent of the session's profit.
profit_target_label = Daily profit target
profit_target_description = The account locks for the rest of the session once session P&L reaches this amount.
drawdown_heading = Maximum drawdown
drawdown_intro = The maximum drawdown trails the account's highest equity across sessions. Once reached, the account stays locked until you unlock it under Live meter; the session boundary does not release it.
maximum_drawdown_label = Maximum drawdown
maximum_drawdown_description = The account locks when equity falls this far below its highest equity.
drawdown_mode_label = Drawdown mode
drawdown_mode_description = Intraday raises the high from live equity; end of day raises it only from the equity at the session boundary.
floor_stop_label = Floor stops at
floor_stop_description = The equity at which the lock level stops rising, usually the starting balance. Leave empty to trail without a limit.
mode_intraday = Intraday
mode_end_of_day = End of day
placeholder_amount = Amount
placeholder_contracts = Contracts
placeholder_off = Off
unsaved_changes = Unsaved changes
save = Save rules
saved = Risk rules saved.
meter_heading = Live meter
meter_empty = The meter appears once rules are saved for this account.
meter_session_pnl = Session P&L
meter_daily_loss_remaining = Room to the daily loss limit
meter_trailing_remaining = Room to the trailing drawdown
meter_profit_target_remaining = Left to the profit target
meter_drawdown_peak = Highest equity
meter_drawdown_floor = Drawdown lock level
meter_drawdown_remaining = Room to the maximum drawdown
meter_lock = Lock
meter_unlocked = Not locked
unlock = Unlock account
problem_no_account = Choose a practice account.
problem_daily_loss = Enter a daily loss limit above zero in the account currency.
problem_maximum_contracts = Enter a maximum number of contracts above zero.
problem_trailing = Enter a trailing drawdown above zero in the account currency, or leave it empty.
problem_consistency = Enter a consistency limit from 1 to 100, or leave it empty.
problem_profit_target = Enter a daily profit target above zero in the account currency, or leave it empty.
problem_maximum_drawdown = Enter a maximum drawdown above zero in the account currency, or leave it empty.
problem_floor_stop = Enter the equity where the floor stops above zero in the account currency, or leave it empty.
problem_floor_stop_without_drawdown = Set a maximum drawdown before choosing where its floor stops.
problem_revision_exhausted = These rules have reached their last revision and cannot be changed.
save_failed = The risk rules could not be saved: {error}
