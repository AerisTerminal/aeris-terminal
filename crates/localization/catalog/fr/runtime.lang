# Texte de marché, de compte et d'étude publié par le runtime : paramètres des études intégrées,
# statistiques de contexte officielles et champs de connexion des fournisseurs. Le texte rédigé
# par les éditeurs (paramètres d'études tierces, titres des publications officielles et noms de
# statistiques) est affiché tel que publié et n'apparaît jamais ici.

## Paramètres des études intégrées
study_setting_period = Période
study_setting_period_description = Nombre de barres d'entrée utilisées par le calcul.
study_setting_deviation = Écart
study_setting_deviation_description = Multiplicateur d'écart type appliqué aux bandes.
study_setting_fast_period = Période rapide
study_setting_fast_period_description = Période de l'EMA rapide.
study_setting_slow_period = Période lente
study_setting_slow_period_description = Période de l'EMA lente.
study_setting_signal_period = Période du signal
study_setting_signal_period_description = Période de l'EMA du signal.
study_setting_k_period = Période %K
study_setting_k_period_description = Fenêtre d'historique de l'oscillateur rapide.
study_setting_d_period = Période %D
study_setting_d_period_description = Fenêtre de lissage de la ligne de signal.

