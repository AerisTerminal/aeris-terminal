# Règles de risque : la section du panneau des comptes qui modifie le profil de risque d'un compte
# d'entraînement (limites journalières, objectif de gain journalier et drawdown maximal) et affiche la jauge en direct.

tab = Règles de risque
heading = Règles de risque
intro = Des règles qu'Aeris applique à un compte d'entraînement, comme lors d'une évaluation de prop firm. Lorsqu'une règle est atteinte, le compte est verrouillé et les nouveaux ordres sont refusés. Les règles journalières sont réinitialisées à la limite de session ; le drawdown maximal ne l'est pas. Les comptes de courtier relèvent de leur courtier.
no_practice_accounts = Créez un compte d'entraînement sous Comptes de trading pour lui donner des règles de risque.
account_label = Compte d'entraînement
account_description = Le compte d'entraînement auquel ces règles s'appliquent.
choose_account = Choisir un compte d'entraînement
enabled_label = Appliquer les règles
status_not_saved = Aucune règle n'est encore enregistrée pour ce compte.
status_enabled = Les règles enregistrées sont appliquées.
status_disabled = Les règles enregistrées sont désactivées et ne sont pas appliquées.
daily_heading = Règles journalières
daily_loss_label = Limite de perte journalière
daily_loss_description = Le compte est verrouillé lorsque la perte de la session atteint ce montant.
maximum_contracts_label = Contrats maximum
maximum_contracts_description = Les ordres qui feraient détenir plus de contrats que ce nombre sont refusés.
trailing_label = Drawdown suiveur
trailing_description = Le compte est verrouillé lorsque le P&L de la session tombe de ce montant sous son plus haut de la session.
trailing_mode_label = Mode du drawdown suiveur
trailing_mode_description = Intraday suit chaque nouveau plus haut ; fin de journée ne déplace le plus haut qu'à la limite de session.
consistency_label = Limite de constance (%)
consistency_description = Avertit lorsqu'un seul trade gagnant représente plus de ce pourcentage du gain de la session.
profit_target_label = Objectif de gain journalier
profit_target_description = Le compte est verrouillé pour le reste de la session dès que le P&L de la session atteint ce montant.
drawdown_heading = Drawdown maximal
drawdown_intro = Le drawdown maximal suit le capital le plus élevé du compte d'une session à l'autre. Une fois atteint, le compte reste verrouillé jusqu'à ce que vous le déverrouilliez sous Jauge en direct ; la limite de session ne le libère pas.
maximum_drawdown_label = Drawdown maximal
maximum_drawdown_description = Le compte est verrouillé lorsque le capital tombe de ce montant sous son capital le plus élevé.
drawdown_mode_label = Mode du drawdown
drawdown_mode_description = Intraday relève le plus haut à partir du capital en direct ; fin de journée le relève uniquement à partir du capital à la limite de session.
floor_stop_label = Le plancher s'arrête à
floor_stop_description = Le capital auquel le niveau de verrouillage cesse de monter, généralement le solde de départ. Laissez vide pour suivre sans limite.
mode_intraday = Intraday
mode_end_of_day = Fin de journée
placeholder_amount = Montant
placeholder_contracts = Contrats
placeholder_off = Désactivé
unsaved_changes = Modifications non enregistrées
save = Enregistrer les règles
saved = Règles de risque enregistrées.
meter_heading = Jauge en direct
meter_empty = La jauge apparaît une fois des règles enregistrées pour ce compte.
meter_session_pnl = P&L de la session
meter_daily_loss_remaining = Marge jusqu'à la limite de perte journalière
meter_trailing_remaining = Marge jusqu'au drawdown suiveur
meter_profit_target_remaining = Reste avant l'objectif de gain
meter_drawdown_peak = Capital le plus élevé
meter_drawdown_floor = Niveau de verrouillage du drawdown
meter_drawdown_remaining = Marge jusqu'au drawdown maximal
meter_lock = Verrouillage
meter_unlocked = Non verrouillé
unlock = Déverrouiller le compte
problem_no_account = Choisissez un compte d'entraînement.
problem_daily_loss = Saisissez une limite de perte journalière supérieure à zéro dans la devise du compte.
problem_maximum_contracts = Saisissez un nombre maximum de contrats supérieur à zéro.
problem_trailing = Saisissez un drawdown suiveur supérieur à zéro dans la devise du compte, ou laissez le champ vide.
problem_consistency = Saisissez une limite de constance de 1 à 100, ou laissez le champ vide.
problem_profit_target = Saisissez un objectif de gain journalier supérieur à zéro dans la devise du compte, ou laissez le champ vide.
problem_maximum_drawdown = Saisissez un drawdown maximal supérieur à zéro dans la devise du compte, ou laissez le champ vide.
problem_floor_stop = Saisissez le capital où le plancher s'arrête, supérieur à zéro dans la devise du compte, ou laissez le champ vide.
problem_floor_stop_without_drawdown = Définissez un drawdown maximal avant de choisir où son plancher s'arrête.
problem_revision_exhausted = Ces règles ont atteint leur dernière révision et ne peuvent plus être modifiées.
save_failed = Les règles de risque n'ont pas pu être enregistrées : {error}
