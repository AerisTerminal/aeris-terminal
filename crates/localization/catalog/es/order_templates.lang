# Problemas
whole_number_required = Introduzca un número entero en el campo resaltado.
invalid_identity = Esta plantilla no se puede guardar con su identidad. Cierre el editor y vuelva a intentarlo.
invalid_revision = Esta plantilla no se puede guardar en su revisión. Cierre el editor y vuelva a intentarlo.
invalid_name = Introduzca un nombre de como máximo {maximum} caracteres, sin espacios al principio ni al final.
invalid_quantity = La cantidad debe estar entre 1 y {maximum}.
invalid_stop = El stop debe estar entre 1 y {maximum} ticks.
invalid_target_count = Una plantilla necesita al menos un objetivo y admite como máximo {maximum}.
invalid_target_offset = Cada objetivo debe estar entre 1 y {maximum} ticks.
invalid_target_order = Cada objetivo debe estar más lejos de la entrada que el anterior.
invalid_target_quantity = Cada objetivo debe tomar una cantidad de al menos 1.
invalid_target_total = Las cantidades de los objetivos deben sumar la cantidad de la plantilla.
invalid_target_split = Estas cantidades de objetivos no se pueden repartir con exactitud. Cambie las cantidades de los objetivos más cercanos.
invalid_trailing = La activación y la distancia del stop dinámico deben estar cada una entre 1 y {maximum} ticks.
too_many = Se pueden guardar como máximo {maximum} plantillas de órdenes. Elimine una primero.
unknown_template = Esta plantilla ya no está guardada.
revision_must_advance = Esta plantilla se modificó en otro lugar. Cierre el editor y vuelva a abrirla.
save_failed = No se pudo guardar la plantilla: {error}
delete_failed = No se pudo eliminar la plantilla: {error}

