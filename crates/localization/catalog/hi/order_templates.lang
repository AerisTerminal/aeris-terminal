delete_confirm = हटाएँ

# समस्याएँ
whole_number_required = चिह्नित फ़ील्ड में पूर्ण संख्या दर्ज करें।
invalid_identity = यह टेम्पलेट अपनी पहचान के साथ सहेजा नहीं जा सकता। संपादक बंद करें और फिर से प्रयास करें।
invalid_revision = यह टेम्पलेट अपने संशोधन पर सहेजा नहीं जा सकता। संपादक बंद करें और फिर से प्रयास करें।
invalid_name = अधिकतम {maximum} वर्णों का नाम दर्ज करें, शुरुआत या अंत में खाली जगह के बिना।
invalid_quantity = मात्रा 1 से {maximum} तक होनी चाहिए।
invalid_stop = स्टॉप 1 से {maximum} टिक तक होना चाहिए।
invalid_target_count = टेम्पलेट में कम से कम एक लक्ष्य चाहिए और अधिकतम {maximum} हो सकते हैं।
invalid_target_offset = हर लक्ष्य 1 से {maximum} टिक तक होना चाहिए।
invalid_target_order = हर लक्ष्य प्रवेश से पिछले लक्ष्य की तुलना में अधिक दूर होना चाहिए।
invalid_target_quantity = हर लक्ष्य की मात्रा कम से कम 1 होनी चाहिए।
invalid_target_total = लक्ष्यों की मात्राओं का योग टेम्पलेट की मात्रा के बराबर होना चाहिए।
invalid_target_split = लक्ष्यों की ये मात्राएँ ठीक-ठीक बाँटी नहीं जा सकतीं। पास वाले लक्ष्यों की मात्राएँ बदलें।
invalid_trailing = ट्रेलिंग स्टॉप की सक्रियता और दूरी, दोनों 1 से {maximum} टिक तक होनी चाहिए।
too_many = अधिकतम {maximum} ऑर्डर टेम्पलेट सहेजे जा सकते हैं। पहले एक हटाएँ।
unknown_template = यह टेम्पलेट अब सहेजा हुआ नहीं है।
revision_must_advance = यह टेम्पलेट कहीं और बदला गया। संपादक बंद करें और इसे फिर से खोलें।
save_failed = टेम्पलेट सहेजा नहीं जा सका: {error}
delete_failed = टेम्पलेट हटाया नहीं जा सका: {error}

# प्रतिक्रिया
saved = ऑर्डर टेम्पलेट {name} सहेजा गया।
deleted = ऑर्डर टेम्पलेट {name} हटाया गया।
