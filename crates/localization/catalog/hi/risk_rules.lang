# रिस्क नियम: अकाउंट पैनल का वह सेक्शन जो प्रैक्टिस अकाउंट की रिस्क प्रोफ़ाइल (दैनिक सीमाएँ,
# दैनिक प्रॉफ़िट लक्ष्य और अधिकतम ड्रॉडाउन) बदलता है और लाइव मीटर दिखाता है।

tab = रिस्क नियम
heading = रिस्क नियम
intro = वे नियम जिन्हें Aeris किसी प्रैक्टिस अकाउंट पर लागू करता है, जैसे प्रॉप फ़र्म के मूल्यांकन में। कोई नियम पूरा होने पर अकाउंट लॉक हो जाता है और नए ऑर्डर अस्वीकार किए जाते हैं। दैनिक नियम सेशन की सीमा पर रीसेट होते हैं; अधिकतम ड्रॉडाउन नहीं। ब्रोकर अकाउंट अपने ब्रोकर के नियमों से चलते हैं।
no_practice_accounts = रिस्क नियम देने के लिए ट्रेडिंग अकाउंट में एक प्रैक्टिस अकाउंट बनाएँ।
account_label = प्रैक्टिस अकाउंट
account_description = वह प्रैक्टिस अकाउंट जिस पर ये नियम लागू होते हैं।
choose_account = प्रैक्टिस अकाउंट चुनें
enabled_label = नियम लागू करें
status_not_saved = इस अकाउंट के लिए अभी कोई नियम सेव नहीं है।
status_enabled = सेव किए गए नियम लागू हैं।
status_disabled = सेव किए गए नियम बंद हैं और लागू नहीं होते।
daily_heading = दैनिक नियम
daily_loss_label = दैनिक हानि सीमा
daily_loss_description = सेशन की हानि इस राशि तक पहुँचने पर अकाउंट लॉक हो जाता है।
maximum_contracts_label = अधिकतम कॉन्ट्रैक्ट
maximum_contracts_description = जिन ऑर्डर से इससे अधिक कॉन्ट्रैक्ट होल्ड होंगे, वे अस्वीकार किए जाते हैं।
trailing_label = ट्रेलिंग ड्रॉडाउन
trailing_description = सेशन का P&L अपने सेशन उच्च से इतना नीचे गिरने पर अकाउंट लॉक हो जाता है।
trailing_mode_label = ट्रेलिंग ड्रॉडाउन मोड
trailing_mode_description = इंट्राडे हर नए उच्च का पालन करता है; दिन का अंत उच्च को केवल सेशन की सीमा पर बदलता है।
consistency_label = कंसिस्टेंसी सीमा (%)
consistency_description = जब एक ही मुनाफ़े वाला ट्रेड सेशन के मुनाफ़े के इस प्रतिशत से अधिक हो, तब चेतावनी देता है।
profit_target_label = दैनिक प्रॉफ़िट लक्ष्य
profit_target_description = सेशन का P&L इस राशि तक पहुँचते ही अकाउंट बाकी सेशन के लिए लॉक हो जाता है।
drawdown_heading = अधिकतम ड्रॉडाउन
drawdown_intro = अधिकतम ड्रॉडाउन सभी सेशन में अकाउंट की सबसे ऊँची इक्विटी के पीछे चलता है। पहुँचने पर अकाउंट तब तक लॉक रहता है जब तक आप उसे लाइव मीटर में अनलॉक न करें; सेशन की सीमा उसे नहीं खोलती।
maximum_drawdown_label = अधिकतम ड्रॉडाउन
maximum_drawdown_description = इक्विटी अपनी सबसे ऊँची इक्विटी से इतना नीचे गिरने पर अकाउंट लॉक हो जाता है।
drawdown_mode_label = ड्रॉडाउन मोड
drawdown_mode_description = इंट्राडे उच्च को लाइव इक्विटी से बढ़ाता है; दिन का अंत उसे केवल सेशन की सीमा की इक्विटी से बढ़ाता है।
floor_stop_label = फ़्लोर यहाँ रुकता है
floor_stop_description = वह इक्विटी जिस पर लॉक स्तर बढ़ना बंद करता है, आमतौर पर शुरुआती बैलेंस। बिना सीमा के ट्रेल करने के लिए खाली छोड़ें।
mode_intraday = इंट्राडे
mode_end_of_day = दिन का अंत
placeholder_amount = राशि
placeholder_contracts = कॉन्ट्रैक्ट
placeholder_off = बंद
unsaved_changes = बिना सेव किए बदलाव
save = नियम सेव करें
saved = रिस्क नियम सेव हो गए।
meter_heading = लाइव मीटर
meter_empty = इस अकाउंट के लिए नियम सेव होने पर मीटर दिखाई देता है।
meter_session_pnl = सेशन P&L
meter_daily_loss_remaining = दैनिक हानि सीमा तक बची गुंजाइश
meter_trailing_remaining = ट्रेलिंग ड्रॉडाउन तक बची गुंजाइश
meter_profit_target_remaining = प्रॉफ़िट लक्ष्य तक बाकी
meter_drawdown_peak = सबसे ऊँची इक्विटी
meter_drawdown_floor = ड्रॉडाउन लॉक स्तर
meter_drawdown_remaining = अधिकतम ड्रॉडाउन तक बची गुंजाइश
meter_lock = लॉक
meter_unlocked = लॉक नहीं
unlock = अकाउंट अनलॉक करें
problem_no_account = एक प्रैक्टिस अकाउंट चुनें।
problem_daily_loss = अकाउंट की मुद्रा में शून्य से अधिक दैनिक हानि सीमा दर्ज करें।
problem_maximum_contracts = शून्य से अधिक कॉन्ट्रैक्ट की अधिकतम संख्या दर्ज करें।
problem_trailing = अकाउंट की मुद्रा में शून्य से अधिक ट्रेलिंग ड्रॉडाउन दर्ज करें या इसे खाली छोड़ें।
problem_consistency = 1 से 100 तक की कंसिस्टेंसी सीमा दर्ज करें या इसे खाली छोड़ें।
problem_profit_target = अकाउंट की मुद्रा में शून्य से अधिक दैनिक प्रॉफ़िट लक्ष्य दर्ज करें या इसे खाली छोड़ें।
problem_maximum_drawdown = अकाउंट की मुद्रा में शून्य से अधिक अधिकतम ड्रॉडाउन दर्ज करें या इसे खाली छोड़ें।
problem_floor_stop = वह इक्विटी दर्ज करें जहाँ फ़्लोर रुकता है, अकाउंट की मुद्रा में शून्य से अधिक, या इसे खाली छोड़ें।
problem_floor_stop_without_drawdown = फ़्लोर कहाँ रुके, यह चुनने से पहले अधिकतम ड्रॉडाउन सेट करें।
problem_revision_exhausted = ये नियम अपने अंतिम संशोधन तक पहुँच गए हैं और बदले नहीं जा सकते।
save_failed = रिस्क नियम सेव नहीं हो सके: {error}
