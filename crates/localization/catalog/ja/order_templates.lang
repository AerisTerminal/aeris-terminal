replay_unsupported = バーリプレイでは 1 つのストップと 1 つのターゲットで取引します。ターゲットが 1 つでトレーリングストップのないテンプレートか「なし」を選択してください。
template_detail = 数量 {quantity} · ストップ {stop}

# エディター
new_title = 新しい注文テンプレート
edit_title = 注文テンプレートを編集
name_label = 名前
name_placeholder = スキャルプ、ターゲット 2 つ
quantity_label = 数量
stop_label = ストップ（ティック）
targets_heading = ターゲット
